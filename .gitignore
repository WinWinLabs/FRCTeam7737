.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ===========================
# Large / Binary Files
# Keep source files; skip exports/renders
# ===========================

# CAD exports that exceed GitHub's 100MB limit — store in Google Drive / Onshape
# *.step     (uncomment if your STEP files are too large)
# *.stp
# *.iges
# *.igs

# Large videos
*.mp4
*.mov
*.avi
*.mkv

# ===========================
# Secrets / Credentials
# (should never be in this repo)
# ===========================
.env
.env.*
*.pem
*.key
secrets/
