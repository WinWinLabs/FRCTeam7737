# ===========================

# Compiled class files
*.class

# VS Code
.vscode/settings.json
.vscode/launch.json
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/

# ===========================
# Operating System
# ===========================

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

